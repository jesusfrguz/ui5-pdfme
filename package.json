{
  "name": "ui5-pdfme",
  "version": "0.1.0",
  "description": "Visual PDF template studio for SAPUI5, OpenUI5, Fiori, React and JavaScript, powered by pdfme.",
  "author": {
    "name": "Jesús Franco Guzmán",
    "url": "https://www.linkedin.com/in/jesus-franco-guzman/"
  },
  "keywords": [
    "openui5",
    "sapui5",
    "fiori",
    "react",
    "javascript",
    "template-designer",
    "pdf",
    "pdfme",
    "odata"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jesusfrguz.github.io/ui5-pdfme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusfrguz/ui5-pdfme.git"
  },
  "bugs": {
    "url": "https://github.com/jesusfrguz/ui5-pdfme/issues"
  },
  "main": "dist-v6/resources/ui5/pdfme/library.js",
  "exports": {
    ".": "./src-web/index.mjs",
    "./react": "./src-web/react.mjs",
    "./ui5": "./dist-v6/resources/ui5/pdfme/library.js",
    "./ui5/*": "./dist-v6/resources/ui5/pdfme/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src-web",
    "agents",
    "docs",
    "examples",
    "dist-v6/resources",
    "ui5.yaml",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prestart": "node scripts/patch-ui5-tooling-modules.cjs",
    "start": "ui5 serve --config ui5.dev.yaml --open /test-resources/ui5/pdfme/demokit/index.html",
    "prestart:legacy": "npm run build",
    "start:legacy": "ui5 serve --config ui5.legacy.yaml --open /test-resources/ui5/pdfme/demokit/index.html",
    "prebuild": "node scripts/patch-ui5-tooling-modules.cjs",
    "build": "ui5 build --config ui5.dev.yaml --dest dist-v6 --clean-dest",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "build:legacy": "ui5 build --config ui5.legacy.yaml --dest .tmp-ui5-1.71-build --clean-dest",
    "docs:dev": "vite docs --host 127.0.0.1",
    "example:js": "vite examples/javascript --host 127.0.0.1",
    "example:react": "vite examples/react --host 127.0.0.1",
    "test": "node --test test/unit-node/*.test.cjs test/unit-node/*.test.mjs",
    "verify": "npm test && npm run build && npm run build:legacy"
  },
  "dependencies": {
    "@pdfme/common": "^6.1.12",
    "@pdfme/generator": "^6.1.12",
    "@pdfme/schemas": "^6.1.12",
    "@pdfme/ui": "^6.1.12"
  },
  "devDependencies": {
    "@pdfme/converter": "^6.1.12",
    "@pdfme/pdf-lib": "^6.1.12",
    "@ui5/cli": "^4.0.62",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "ui5-tooling-modules": "^3.38.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  }
}
