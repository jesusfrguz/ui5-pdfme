<mvc:View
  controllerName="ui5.pdfme.demokit.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:pdf="ui5.pdfme">
  <App>
    <Page title="ui5-pdfme" showHeader="true">
      <content>
        <MessageStrip
          class="sapUiSmallMargin"
          text="Selecciona una plantilla del catálogo. Puedes buscar, filtrar, abrirla, editarla y guardarla en el repositorio de ejemplo."
          type="Information"
          showIcon="true" />
        <pdf:PdfTemplateStudio
          id="studio"
          class="sapUiSmallMargin"
          height="calc(100vh - 9rem)"
          filename="factura-demo.pdf"
          language="es"
          error="onError" />
      </content>
    </Page>
  </App>
</mvc:View>
